.ship-3d-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx 20rpx;
}

.back-btn {
  width: 70rpx;
  height: 70rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 70rpx;
}

.model-container {
  padding: 30rpx;
}

.model-wrapper {
  width: 100%;
  height: 400rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.3);
}

.ship-image {
  width: 100%;
  height: 100%;
  transition: transform 0.3s ease;
}

.swipe-hint {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 20rpx;
}

.rotation-indicator {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.indicator-dot {
  width: 16rpx;
  height: 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.indicator-dot.active {
  width: 40rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
}

.ship-info {
  background: rgba(255,255,255,0.95);
  border-radius: 32rpx 32rpx 0 0;
  padding: 30rpx;
  margin-top: 20rpx;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ship-icon {
  font-size: 48rpx;
}

.ship-title {
  display: flex;
  flex-direction: column;
}

.ship-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.ship-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.info-tabs {
  display: flex;
  background: #f5f3ef;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #fff;
  color: #a34d2e;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.info-panel {
  min-height: 200rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0ebe5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #888;
}

.value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.history-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.tech-item {
  margin-bottom: 20rpx;
}

.tech-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tech-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.detail-btn {
  margin: 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
}