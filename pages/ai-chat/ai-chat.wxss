.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f3ef;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.header-left {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-avatar {
  width: 70rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.header-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.header-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  background: #4ade80;
  border-radius: 50%;
}

.header-right {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.clear-icon {
  font-size: 32rpx;
}

.chat-container {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
  padding-bottom: 180rpx;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.welcome-avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 30rpx;
}

.welcome-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.welcome-hint {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 50rpx;
}

.quick-questions {
  width: 100%;
}

.quick-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.quick-item:active {
  background: #f0e6dc;
}

.message-row {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.user-row {
  flex-direction: row-reverse;
}

.ai-row {
  flex-direction: row;
}

.message-avatar {
  width: 70rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  flex-shrink: 0;
}

.message-content {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
}

.user-message {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  color: #fff;
  margin-left: 20rpx;
  border-bottom-right-radius: 8rpx;
}

.ai-message {
  background: #fff;
  color: #333;
  margin-right: 20rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
  text-align: right;
}

.ai-message .message-time {
  color: #999;
}

.loading-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.loading-row.hidden {
  display: none;
}

.loading-message {
  padding: 24rpx 30rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #d4a574;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background: #f5f3ef;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  background: #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.send-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}