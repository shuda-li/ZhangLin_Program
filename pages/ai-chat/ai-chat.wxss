.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #fdf8f3 0%, #f5ebe0 100%);
}

.chat-header {
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(60, 30, 10, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.header-right { width: 80rpx; }

.back-arrow {
  transform: rotate(-45deg);
  color: #8b3a1a;
  transition: transform 0.2s ease;
}
.header-left:active .back-arrow { transform: rotate(-45deg) scale(0.86); }

.header-center {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.chat-avatar {
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #b86a3a, #8b3a1a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(139, 58, 26, 0.2);
}

.chat-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3c2b23;
  letter-spacing: 1rpx;
}

.messages-container {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.message-wrapper {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.user-wrapper {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(60, 30, 10, 0.1);
}

.ai-wrapper .message-avatar {
  background: linear-gradient(135deg, #d4a574 0%, #c89050 100%);
  margin-right: 18rpx;
}

.user-wrapper .message-avatar {
  background: linear-gradient(135deg, #b86a3a 0%, #8b3a1a 100%);
  margin-left: 18rpx;
}

.message-bubble {
  max-width: 520rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  line-height: 1.6;
  font-size: 28rpx;
  word-wrap: break-word;
}

.ai-bubble {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.user-bubble {
  background: linear-gradient(135deg, #b86a3a 0%, #8b3a1a 100%);
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.loading-dots .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c89050;
  animation: dotPulse 1.4s infinite;
}

.loading-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 60%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  30% {
    transform: scale(1);
    opacity: 1;
  }
}

.quick-questions {
  margin-top: 48rpx;
}

.quick-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
  text-align: center;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.quick-item {
  padding: 20rpx 32rpx;
  background: #fff;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: #b26a1e;
  border: 2rpx solid rgba(178, 106, 30, 0.18);
  transition: all 0.25s ease;
}

.quick-item:active {
  background: #f7ecdd;
  transform: scale(0.97);
}

.input-container {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #f0e0d4;
  box-shadow: 0 -4rpx 16rpx rgba(60, 30, 10, 0.04);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #f8f8f8;
  border-radius: 48rpx;
  padding: 8rpx 16rpx 8rpx 32rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  line-height: 72rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 50%;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.25s ease, box-shadow 0.25s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #8b3a1a 0%, #b86a3a 100%);
  box-shadow: 0 4rpx 12rpx rgba(139, 58, 26, 0.35);
}

/* 统一线性图标适配：图标统一使用 36rpx 基准，伪元素坐标才不会偏移 */
.chat-avatar .ui-icon,
.message-avatar .ui-icon,
.send-btn .send-icon { color: #fff; }