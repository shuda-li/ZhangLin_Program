.guide-page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: 140rpx;
}

.guide-header {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/></svg>') repeat;
  background-size: 20px 20px;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 30rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.guide-tabs {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  gap: 20rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #f5f3ef;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.tab-icon {
  font-size: 28rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #fff;
}

.guide-content {
  padding: 20rpx;
}

.flow-view {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.flow-container {
  position: relative;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
}

.flow-line {
  position: absolute;
  left: 50rpx;
  top: 80rpx;
  bottom: 80rpx;
  width: 4rpx;
  background: linear-gradient(to bottom, #d4a574 0%, #c19660 50%, #8b3a1a 100%);
  border-radius: 2rpx;
}

.flow-nodes {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.flow-node {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f7efe5;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.flow-node.active {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.node-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  font-size: 32rpx;
}

.node-info {
  flex: 1;
}

.node-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.flow-node.active .node-name {
  color: #fff;
}

.node-time {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.flow-node.active .node-time {
  color: rgba(255,255,255,0.7);
}

.node-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d4a574;
}

.flow-node.active .node-indicator {
  background: #fff;
  box-shadow: 0 0 10rpx rgba(255,255,255,0.5);
}

.flow-detail {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.detail-icon {
  font-size: 48rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.detail-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 30rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: #f5f3ef;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  background: #f5f3ef;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.action-btn.primary {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  color: #fff;
}

.list-view {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spot-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.spot-image {
  width: 240rpx;
  height: 200rpx;
  object-fit: cover;
}

.spot-info {
  flex: 1;
  padding: 20rpx;
}

.spot-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.spot-summary {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.spot-tags {
  display: flex;
  gap: 8rpx;
}

.map-view {
  height: calc(100vh - 400rpx);
}

.guide-map {
  width: 100%;
  height: 100%;
}