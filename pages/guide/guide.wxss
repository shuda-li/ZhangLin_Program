/* ===== 智慧地图卡片 ===== */
.guide-map-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.map-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
}

.map-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-heading);
}

.map-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.map-locate-btn {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f5ebe0;
  color: var(--color-primary);
  font-size: 22rpx;
  border: 1rpx solid rgba(180, 140, 100, 0.2);
}

.map-legend {
  display: flex;
  gap: 32rpx;
  padding: 16rpx 28rpx;
  border-top: 1rpx solid rgba(180, 140, 100, 0.1);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(139, 58, 26, 0.3);
}

.legend-line {
  width: 30rpx;
  height: 4rpx;
  background: var(--color-accent);
  border-radius: 2rpx;
}

/* ===== AI 推荐卡片 ===== */
.ai-rec-card {
  background: linear-gradient(135deg, rgba(60,30,10,0.93), rgba(80,45,20,0.9));
  border: 1rpx solid rgba(200, 160, 100, 0.15);
  margin-bottom: 18rpx;
  position: relative;
  overflow: hidden;
}

.ai-rec-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200,144,80,0.1), transparent);
  pointer-events: none;
}

.ai-rec-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ai-rec-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.5);
  animation: pulse 2s ease-in-out infinite;
}

.ai-rec-label {
  font-size: 22rpx;
  color: rgba(220, 190, 150, 0.85);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.ai-rec-body {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.ai-rec-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.ai-rec-text {
  font-size: 24rpx;
  color: rgba(240, 215, 180, 0.8);
  line-height: 1.7;
}

/* ===== 路线标签 ===== */
.route-tabs {
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.route-tab-wrap {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 4rpx;
}

.route-tab {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #fdf3e3;
  color: #8a5a35;
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.route-tab-active {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(139, 58, 26, 0.25);
}

/* ===== 路线摘要卡片 ===== */
.route-summary {
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, #fdf8f3, #fff);
  border: 1rpx solid rgba(200, 155, 110, 0.1);
}

.route-summary-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-heading);
}

.route-duration-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.route-meta-row {
  display: flex;
  gap: 28rpx;
  margin-top: 16rpx;
}

.route-meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.meta-icon {
  font-size: 24rpx;
}

.route-description {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* ===== 语音导览卡片 ===== */
.voice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, #fef9f3, #fff5ec);
  border: 1rpx solid rgba(200, 150, 100, 0.18);
}

.voice-content {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.voice-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-icon {
  font-size: 30rpx;
}

.voice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-heading);
}

.voice-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.voice-play-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 58, 26, 0.25);
}

/* ===== 路线流程图 ===== */
.flow-chart-card {
  padding: 30rpx;
  background: linear-gradient(135deg, #fdf8f3, #fff);
  margin-bottom: 18rpx;
}

.flow-chart {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.flow-item {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}

.flow-node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 58, 26, 0.3);
  z-index: 1;
  transition: transform 0.2s ease;
}

.flow-node:active {
  transform: scale(0.95);
}

.flow-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.flow-line {
  flex: 1;
  height: 4rpx;
  background: linear-gradient(to right, var(--color-accent), rgba(200, 144, 80, 0.3));
  margin: 0 8rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.flow-arrow {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid var(--color-accent);
}

.flow-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 10rpx;
}

.flow-label {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  transition: background 0.2s ease;
}

.flow-label:active {
  background: rgba(200, 144, 80, 0.1);
  border-radius: 8rpx;
}

.label-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-heading);
  display: block;
}

.label-time {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
  display: block;
}

/* ===== 时间轴可视化 ===== */
.timeline-container {
  padding-left: 40rpx;
}

.timeline-row {
  display: flex;
  gap: 0;
  position: relative;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
  flex-shrink: 0;
  margin-left: -40rpx;
  position: relative;
}

.timeline-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(139, 58, 26, 0.3);
  z-index: 1;
}

.timeline-line {
  width: 3rpx;
  flex: 1;
  min-height: 40rpx;
  background: linear-gradient(to bottom, var(--color-accent), rgba(200, 144, 80, 0.15));
  margin-top: 8rpx;
  margin-bottom: 8rpx;
}

.timeline-card {
  flex: 1;
  margin-left: 20rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 252, 247, 0.95);
  border: 1rpx solid rgba(200, 155, 110, 0.08);
}

.timeline-card:last-child {
  margin-bottom: 0;
}

.stop-time {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.stop-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-heading);
}

.stop-detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.stop-walk {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(200, 150, 100, 0.2);
  font-size: 20rpx;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.walk-icon {
  font-size: 22rpx;
}

/* ===== 附近服务 ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180rpx, 1fr));
  gap: 16rpx;
}

.service-item {
  text-align: center;
  padding: 20rpx 10rpx;
  background: rgba(255, 252, 247, 0.9);
}

.service-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.service-name {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-heading);
}

.service-dist {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* ===== 游玩建议 ===== */
.tip-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.tip-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #f5ebe0;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  line-height: 1.8;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  word-break: break-all;
  white-space: normal;
}

/* ===== 底部弹窗面板（与风物故事弹层统一） ===== */
.stop-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.stop-detail-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.stop-detail-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 -6rpx 36rpx rgba(60, 30, 10, 0.12);
}

.stop-detail-panel.show { transform: translateY(0); }
.stop-detail-panel.snapping { transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1), height 0.3s cubic-bezier(0.22, 0.61, 0.36, 1); }
.stop-detail-panel.dragging { transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1); }
.stop-detail-panel.expanded { border-radius: 0; }

.panel-handle-area {
  flex-shrink: 0;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d4c5b0;
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx 16rpx;
}

.panel-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f0e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.panel-close .ui-icon { color: #8a6a4d; }

.panel-stop-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.panel-stop-info {
  flex: 1;
}

.panel-stop-time {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.panel-stop-title {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-heading);
}

.panel-content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0 28rpx 20rpx;
}

.panel-stop-detail {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
}

/* ===== 评论区入口与区块 ===== */
.route-comments-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: var(--color-tag-bg);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.route-comments-entry .ui-icon { color: var(--color-primary); }

.entry-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: auto;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
  opacity: .55;
}

.route-comments-card {
  padding: 24rpx 26rpx 8rpx;
}

.route-comments-subtitle {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.panel-comments {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(200, 150, 100, .18);
}

.panel-images {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow-x: auto;
}

.panel-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.panel-actions {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  margin: 0 28rpx;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(200, 150, 100, 0.1);
}

.panel-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #f5ebe0;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid rgba(180, 140, 100, 0.2);
}

.panel-btn.primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: #fff;
  border: none;
}

/* ===== AI 对话按钮 ===== */
.ai-chat-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(139, 58, 26, 0.35);
  z-index: 100;
  transition: all 0.3s ease;
}

.ai-chat-btn.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(20rpx);
}

.ai-chat-icon {
  font-size: 36rpx;
}

.ai-chat-text {
  font-size: 20rpx;
  color: #fff;
  margin-top: 4rpx;
}

/* ===== AI 对话窗口 ===== */
.ai-chat-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 202;
  transform: translateY(100%);
  transition: transform 0.36s cubic-bezier(0.22, 0.61, 0.36, 1);
  box-shadow: 0 -6rpx 36rpx rgba(60, 30, 10, 0.12);
  height: 75vh;
  display: flex;
  flex-direction: column;
}

.ai-chat-container.show {
  transform: translateY(0);
}

.ai-chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid rgba(200, 150, 100, 0.1);
}

.ai-chat-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-avatar {
  font-size: 36rpx;
}

.ai-chat-title text:last-child {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-heading);
}

.ai-chat-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5ebe0;
  color: var(--color-primary);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-chat-messages {
  flex: 1;
  padding: 20rpx 32rpx;
  overflow-y: auto;
}

.chat-message {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.chat-message.user-message {
  flex-direction: row-reverse;
}

.chat-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f5ebe0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.user-message .chat-avatar {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
}

.chat-content {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.ai-message .chat-content {
  background: #fdf8f3;
  color: var(--color-text-heading);
  border-radius: 20rpx 20rpx 20rpx 6rpx;
}

.user-message .chat-content {
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}

.ai-chat-input {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(200, 150, 100, 0.1);
  background: #fff;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5ebe0;
  font-size: 24rpx;
}

.chat-send-btn {
  width: 88rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.ai-message .chat-content.isLoading {
  background: #fdf8f3;
  color: var(--color-primary);
  animation: pulse 1.5s ease-in-out infinite;
}

.ai-message .chat-content.isLoading::after {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-left: 8rpx;
  animation: pulse 1s ease-in-out infinite;
}

.chat-content.has-tools {
  position: relative;
}

.chat-content.has-tools::before {
  content: '';
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

/* ===== 图标适配（统一线性图标，无 emoji） ===== */
.map-locate-btn { display: inline-flex; align-items: center; gap: 6rpx; }
.ai-rec-icon { color: var(--color-accent); }
.meta-icon.ui-icon { color: var(--color-primary); }
.meta-dot {
  display: inline-block;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.meta-dot-easy { background: #5aa76a; }
.meta-dot-normal { background: #d9a441; }
.voice-icon.ui-icon { color: #fff; }
