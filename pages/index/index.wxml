<import src="../../templates/card-templates" />
<view class="page home-page">
  <!-- 1. 品牌头图 -->
  <view class="hero">
    <swiper class="hero-swiper" indicator-dots="{{true}}" indicator-active-color="#ffffff" autoplay="{{true}}" interval="4000" circular="{{true}}">
      <block wx:for="{{homeBanners}}" wx:key="id">
        <swiper-item>
          <view class="hero-slide" bindtap="handleActionTap" data-action="{{item.action}}" data-target="{{item.target}}">
            <image class="hero-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="hero-mask"></view>
            <view class="hero-overlay">
              <view class="hero-subtitle">{{item.subtitle}}</view>
              <view class="hero-title">{{item.title}}</view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>
    <view class="hero-panel">
      <view class="hero-brand">樟林归舟</view>
      <view class="hero-copy">红头船文化 · 侨乡文脉 · 古港遗址</view>
      <view class="hero-actions">
        <view class="button-primary ui-press" catchtap="openGuide">开始导览</view>
      </view>
    </view>
  </view>

  <!-- 2. 概览指标（合并原统计卡与今日古港） -->
  <view class="stats-grid">
    <block wx:for="{{homeStats}}" wx:key="label">
      <view class="stat-item ui-press" bindtap="handleStatTap" data-target="{{item.target}}">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </block>
  </view>

  <!-- 3. 快捷操作（上移，核心入口前置） -->
  <view class="section quick-section">
    <view class="quick-grid">
      <block wx:for="{{quickServices}}" wx:key="title">
        <view class="quick-item ui-press" bindtap="handleActionTap" data-action="{{item.action}}" data-target="{{item.target}}">
          <view class="quick-icon"><view class="ui-icon {{item.icon}} ui-icon-lg"></view></view>
          <view class="quick-title">{{item.title}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 4. AI 助手（核心功能，精简为单行入口） -->
  <view class="section ai-section">
    <view class="card ai-card ui-press" bindtap="openAiGuide">
      <view class="ai-row">
        <view class="ai-icon-wrap"><view class="ui-icon ui-icon-chat ui-icon-lg"></view></view>
        <view class="ai-copy">
          <view class="ai-title">阿樟 · 随时为你讲解</view>
          <view class="ai-sub">红头船历史、游玩路线、古港故事</view>
        </view>
        <view class="ai-enter">进入对话<view class="ui-icon ui-icon-arrow ui-icon-sm"></view></view>
      </view>
    </view>
  </view>

  <!-- 5. 精选景点 -->
  <view class="section" id="featured-section">
    <view class="section-head">
      <view class="section-title">精选景点</view>
      <view class="section-more ui-press" bindtap="openGuide">查看导览<view class="ui-icon ui-icon-arrow ui-icon-sm"></view></view>
    </view>
    <scroll-view class="popular-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="popular-row">
        <block wx:for="{{popularSpots}}" wx:key="id">
          <view class="popular-card ui-press" bindtap="openSpot" data-id="{{item.id}}">
            <image class="popular-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="popular-name">{{item.name}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 6. 主题线路：单条主推 + 更多入口 -->
  <view class="section" id="route-section">
    <view class="section-head">
      <view class="section-title">主题线路</view>
      <view class="section-more ui-press" bindtap="openGuide">全部线路<view class="ui-icon ui-icon-arrow ui-icon-sm"></view></view>
    </view>
    <view class="card card-tap-fb" wx:if="{{featuredRoute}}" catchtap="openGuide" data-route-id="{{featuredRoute.id}}">
      <template is="route-card" data="{{route: featuredRoute}}" />
    </view>
  </view>

  <!-- 7. 更多发现：次要内容分组折叠收纳
       说明：内容始终渲染，仅用包裹层 height 过渡实现平滑展开/收起；
       避免 wx:if 销毁重建导致的突变与退出动画缺失。 -->
  <view class="section more-section">
    <view class="section-head">
      <view class="section-title">更多发现</view>
      <view class="section-more ui-press" bindtap="toggleMore">{{showMore ? '收起' : '展开全部'}}<view class="ui-icon ui-icon-up ui-icon-sm fold-arrow {{showMore ? 'fold-arrow-open' : ''}}"></view></view>
    </view>

    <!-- 收起态：分类快捷入口 -->
    <view class="fold-wrap" style="height: {{foldHeight.teaser}}">
      <view class="fold-inner" id="fold-inner-teaser">
        <view class="more-teaser">
          <view class="teaser-item ui-press" bindtap="openMoreGroup" data-group="culture">文化时间轴</view>
          <view class="teaser-item ui-press" bindtap="openMoreGroup" data-group="activity">近期活动</view>
          <view class="teaser-item ui-press" bindtap="openMoreGroup" data-group="map">景点地图</view>
        </view>
      </view>
    </view>

    <!-- 展开态：分组卡片 -->
    <view class="fold-wrap" style="height: {{foldHeight.more}}">
      <view class="fold-inner" id="fold-inner-more">
        <view class="more-groups">
          <!-- 分组卡片：文化时间轴 -->
          <view class="more-group">
            <view class="more-group-head" bindtap="toggleGroup" data-group="culture">
              <view class="more-group-icon"><view class="ui-icon ui-icon-book ui-icon-lg"></view></view>
              <view class="more-group-copy">
                <view class="more-group-title">海丝文化时间轴</view>
                <view class="more-group-sub">七百年变迁 · 从开港通商到数字文旅</view>
              </view>
              <view class="ui-icon ui-icon-up ui-icon-sm fold-arrow {{expandedGroups.culture ? 'fold-arrow-open' : ''}}"></view>
            </view>
            <view class="fold-wrap" style="height: {{foldHeight.culture}}">
              <view class="fold-inner" id="fold-inner-culture">
                <view class="more-group-body">
                  <scroll-view class="timeline-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
                    <view class="timeline-row">
                      <block wx:for="{{cultureTimeline}}" wx:key="year">
                        <view class="timeline-node">
                          <view class="timeline-dot"></view>
                          <view class="timeline-year">{{item.year}}</view>
                          <view class="timeline-event">{{item.event}}</view>
                        </view>
                      </block>
                    </view>
                  </scroll-view>
                </view>
              </view>
            </view>
          </view>

          <!-- 分组卡片：近期活动 -->
          <view class="more-group">
            <view class="more-group-head" bindtap="toggleGroup" data-group="activity">
              <view class="more-group-icon"><view class="ui-icon ui-icon-calendar ui-icon-lg"></view></view>
              <view class="more-group-copy">
                <view class="more-group-title">近期活动</view>
                <view class="more-group-sub">讲解专场 · 夜游体验 · 亲子研学</view>
              </view>
              <view class="ui-icon ui-icon-up ui-icon-sm fold-arrow {{expandedGroups.activity ? 'fold-arrow-open' : ''}}"></view>
            </view>
            <view class="fold-wrap" style="height: {{foldHeight.activity}}">
              <view class="fold-inner" id="fold-inner-activity">
                <view class="more-group-body">
                  <view class="more-group-action ui-press" bindtap="openActivity">查看全部活动<view class="ui-icon ui-icon-arrow ui-icon-sm"></view></view>
                  <block wx:for="{{hotActivities}}" wx:key="id">
                    <view class="card card-tap-fb" bindtap="openActivity">
                      <template is="activity-card" data="{{activity: item}}" />
                    </view>
                  </block>
                </view>
              </view>
            </view>
          </view>

          <!-- 分组卡片：景点地图 -->
          <view class="more-group">
            <view class="more-group-head" bindtap="toggleGroup" data-group="map">
              <view class="more-group-icon"><view class="ui-icon ui-icon-pin ui-icon-lg"></view></view>
              <view class="more-group-copy">
                <view class="more-group-title">景点地图</view>
                <view class="more-group-sub">古港核心区点位分布</view>
              </view>
              <view class="ui-icon ui-icon-up ui-icon-sm fold-arrow {{expandedGroups.map ? 'fold-arrow-open' : ''}}"></view>
            </view>
            <view class="fold-wrap" style="height: {{foldHeight.map}}">
              <view class="fold-inner" id="fold-inner-map">
                <view class="more-group-body">
                  <view class="card map-card">
                    <map
                      class="home-map"
                      latitude="23.461"
                      longitude="116.780"
                      scale="15"
                      markers="{{mapMarkers}}"
                      bindmarkertap="onMarkerTap"
                    />
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="back-top {{showBackTop ? 'back-top-show' : ''}}" bindtap="scrollToTop">
    <view class="ui-icon ui-icon-up"></view>
  </view>
</view>
