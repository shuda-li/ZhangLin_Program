/* ===== 首页：精简布局 · 统一视觉语言 =====
   设计原则：一屏一主题、留白优先、层级清晰、无装饰性干扰。
   间距基准：section 32rpx / card 内边距 24rpx / 元素间距 16rpx。
   ==================================================== */

.home-page { padding: 0 24rpx 180rpx; }

/* ---------- 1. 品牌头图 ---------- */
.hero {
  margin: 0 -24rpx;
  padding: 0;
  background: #2a160b;
  border-radius: 0;
  box-shadow: none;
  overflow: hidden;
}
.hero-swiper,
.hero-slide { height: 420rpx; }
.hero-image { width: 100%; height: 100%; display: block; }
.hero-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(20, 8, 4, 0.86), rgba(30, 12, 6, 0.32), transparent);
}
.hero-overlay {
  position: absolute;
  left: 36rpx; right: 36rpx; bottom: 32rpx;
  z-index: 2;
}
.hero-subtitle {
  font-size: 21rpx;
  color: rgba(255, 222, 186, 0.85);
  letter-spacing: 3rpx;
}
.hero-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #fff;
}
.hero-panel {
  padding: 24rpx 36rpx 26rpx;
  background: #241207;
  border-top: 1rpx solid rgba(255, 210, 160, 0.10);
}
.hero-brand {
  font-size: 27rpx;
  font-weight: 700;
  color: #f6dfc7;
}
.hero-copy {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: rgba(255, 224, 192, 0.62);
}
.hero-actions { margin-top: 22rpx; }
.hero-actions .button-primary {
  min-width: 220rpx;
  border-radius: 12rpx;
  background: #b86a3a;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.22);
}

/* ---------- 2. 概览指标 ---------- */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 24rpx;
  padding: 20rpx 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}
.stat-item { text-align: center; position: relative; }
.stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0; top: 12%; height: 76%; width: 1rpx;
  background: var(--color-border-light);
}
.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* ---------- 通用区块 ---------- */
.section { margin-top: 32rpx; }
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  min-height: 44rpx;
}
.section-title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--color-text-heading);
  line-height: 1.3;
}
.section-more {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 23rpx;
  color: var(--color-primary-light);
}
.section-more .ui-icon { color: var(--color-primary-light); }
.section-subtitle-inline {
  font-size: 21rpx;
  color: var(--color-text-muted);
}

/* ---------- 3. 快捷操作（核心入口前置） ---------- */
.quick-section { margin-top: 20rpx; }
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 8rpx;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #f4e8dc;
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-title {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

/* ---------- 4. AI 助手（精简单行入口） ---------- */
.ai-section { margin-top: 20rpx; }
.ai-card { padding: 24rpx; }
.ai-row { display: flex; align-items: center; gap: 18rpx; }
.ai-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #f3e6d8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  flex-shrink: 0;
}
.ai-copy { flex: 1; min-width: 0; }
.ai-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text-heading);
}
.ai-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ai-enter {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-tag-bg);
  color: var(--color-tag-text);
  font-size: 21rpx;
}
.ai-enter .ui-icon { color: var(--color-tag-text); }

/* ---------- 7. 更多发现：分组折叠 ---------- */
.more-section { margin-top: 40rpx; }

/* 折叠包裹层：内容常驻渲染，仅对 height 做过渡。
   overflow:hidden 负责裁剪；外壳不设 margin/padding，避免收起时残留间隙导致跳动。 */
.fold-wrap {
  overflow: hidden;
  transition: height 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: height;
}
.fold-inner { width: 100%; }

.fold-arrow {
  transform: rotate(180deg);
  transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.fold-arrow-open { transform: rotate(0deg); }
.more-teaser {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.teaser-item {
  flex: 1 1 0;
  min-width: 0;
  padding: 18rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-card);
  border-radius: 14rpx;
  box-shadow: var(--shadow-card);
}
.more-groups { display: flex; flex-direction: column; gap: 16rpx; }
.more-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.more-group-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}
.more-group-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--color-tag-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.more-group-copy { flex: 1; min-width: 0; }
.more-group-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text-heading);
}
.more-group-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 内容区不再使用入场动画：高度过渡由 .fold-wrap 统一负责，
   避免双层动画叠加造成的跳动。 */
.more-group-body { padding: 0 24rpx 24rpx; }
.more-group-action {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--color-primary-light);
}

/* ---------- 次要内容：时间轴 ---------- */
.timeline-scroll { margin-top: 4rpx; white-space: nowrap; }
.timeline-row { display: inline-flex; gap: 8rpx; align-items: flex-start; padding: 8rpx 0 4rpx; }
.timeline-node { text-align: center; position: relative; min-width: 132rpx; }
.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin: 0 auto 14rpx;
  background: var(--color-primary-light);
  position: relative;
}
.timeline-dot::after {
  content: '';
  position: absolute;
  top: 9rpx; left: 20rpx;
  width: 112rpx; height: 2rpx;
  background: var(--color-border-light);
}
.timeline-node:last-child .timeline-dot::after { display: none; }
.timeline-year {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-heading);
}
.timeline-event {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
  white-space: normal;
  line-height: 1.4;
}

/* ---------- 6. 精选景点 ---------- */
.popular-scroll { white-space: nowrap; }
.popular-row { display: inline-flex; gap: 16rpx; padding: 2rpx 0 6rpx; }
.popular-card {
  width: 224rpx;
  display: inline-block;
  vertical-align: top;
  background: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.popular-image { width: 100%; height: 140rpx; display: block; }
.popular-name {
  padding: 14rpx 16rpx 16rpx;
  font-size: 23rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 7/8. 线路与活动卡片间距 ---------- */
.card-spacing { margin-top: 14rpx; }

/* ---------- 次要内容：地图 ---------- */
.map-card { padding: 16rpx; margin-top: 0; }
.home-map { width: 100%; height: 280rpx; border-radius: 12rpx; }

/* 尊重系统「减少动态效果」偏好 */
@media (prefers-reduced-motion: reduce) {
  .fold-wrap { transition-duration: 0.01ms; }
  .fold-arrow { transition-duration: 0.01ms; }
}

/* ---------- 响应式：宽屏约束内容宽度，窄屏压缩间距 ---------- */
@media (min-width: 720px) {
  .home-page { max-width: 960rpx; margin: 0 auto; padding-left: 0; padding-right: 0; }
  .hero { margin: 0; border-radius: 0 0 24rpx 24rpx; }
  .hero-swiper, .hero-slide { height: 480rpx; }
  .quick-grid { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  .home-map { height: 360rpx; }
}
@media (max-width: 360px) {
  .home-page { padding-left: 16rpx; padding-right: 16rpx; }
  .hero { margin: 0 -16rpx; }
  .quick-grid { gap: 8rpx; }
  .quick-title { font-size: 20rpx; }
  .ai-sub { display: none; }
  .more-group-head { padding: 18rpx 16rpx; gap: 12rpx; }
  .more-group-body { padding: 0 16rpx 20rpx; }
}

/* ---------- 返回顶部 ---------- */
.back-top {
  position: fixed;
  right: 28rpx;
  bottom: 200rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  opacity: 0;
  transform: scale(0.88);
  transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  pointer-events: none;
  z-index: 998;
  box-shadow: 0 6rpx 20rpx rgba(139, 58, 26, 0.3);
}
.back-top-show { opacity: 1; transform: scale(1); pointer-events: auto; }
