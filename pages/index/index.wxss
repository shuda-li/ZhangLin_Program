.page-wrapper {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f3ef;
}

.main-scroll {
  flex: 1;
  height: calc(100vh - 100rpx);
}

.page-content {
  padding-bottom: 140rpx;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  background: #f5f3ef;
}

.location-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.location-icon {
  font-size: 28rpx;
}

.location-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.top-actions {
  display: flex;
  gap: 20rpx;
}

.ai-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 30rpx;
}

.ai-icon {
  font-size: 28rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.hero-section {
  position: relative;
  height: 400rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 50%, #c19660 100%);
  overflow: hidden;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/></svg>') repeat;
  background-size: 20px 20px;
}

.hero-content {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  padding-top: 80rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  letter-spacing: 8rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

.typewriter-wrapper {
  margin-top: 30rpx;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.typewriter-text {
  font-size: 26rpx;
  color: #fff;
  line-height: 1.6;
}

.typewriter-cursor {
  animation: blink 1s infinite;
  color: rgba(255,255,255,0.5);
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.hero-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
}

.hero-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 30rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #a34d2e;
}

.stat-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  background: #e8e4de;
}

.quick-services {
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #a34d2e;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.service-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.service-item.primary-service {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.service-icon {
  font-size: 40rpx;
}

.service-info {
  flex: 1;
}

.service-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.primary-service .service-title {
  color: #fff;
}

.service-desc {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.primary-service .service-desc {
  color: rgba(255,255,255,0.8);
}

.section-spacing {
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  opacity: 0;
  transform: translateY(30rpx);
  transition: all 0.6s ease;
}

.section-spacing.in-view {
  opacity: 1;
  transform: translateY(0);
}

.card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.ship-showcase {
  padding: 30rpx;
}

.ship-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.ship-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ship-icon-3d {
  font-size: 48rpx;
}

.ship-title-group {
  display: flex;
  flex-direction: column;
}

.ship-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.ship-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.ship-badge {
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
}

.ship-stage {
  background: linear-gradient(135deg, #f7efe5 0%, #ede5d8 100%);
  border-radius: 16rpx;
  padding: 30rpx;
}

.ship-model {
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ship-img {
  width: 280rpx;
  height: 180rpx;
  object-fit: contain;
}

.ship-glow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 40rpx;
  background: radial-gradient(ellipse, rgba(212,165,116,0.3) 0%, transparent 70%);
}

.ship-hint {
  text-align: center;
  font-size: 24rpx;
  color: #a34d2e;
  margin-top: 16rpx;
}

.timeline-scroll {
  white-space: nowrap;
  padding: 20rpx 0;
}

.timeline-track {
  display: inline-flex;
  gap: 30rpx;
  padding: 0 10rpx;
}

.timeline-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}

.timeline-year {
  font-size: 32rpx;
  font-weight: bold;
  color: #a34d2e;
  margin-bottom: 12rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  background: #d4a574;
  border-radius: 50%;
  margin-bottom: 16rpx;
  position: relative;
}

.timeline-dot::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 60rpx;
  background: linear-gradient(to bottom, #d4a574 0%, transparent 100%);
}

.timeline-item:last-child .timeline-dot::after {
  display: none;
}

.timeline-content {
  text-align: center;
}

.timeline-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.4;
}

.timeline-item.highlight .timeline-year {
  color: #8b3a1a;
}

.timeline-item.highlight .timeline-dot {
  width: 20rpx;
  height: 20rpx;
  background: #8b3a1a;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 20rpx;
}

.dashboard-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.main-card {
  grid-row: span 2;
}

.card-image-wrapper {
  position: relative;
  height: 300rpx;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 12rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #fff;
}

.card-body {
  padding: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.card-location,
.card-time {
  font-size: 22rpx;
  color: #888;
}

.card-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background: #f5f3ef;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #666;
}

.tag.tag-family {
  background: #fff3e6;
  color: #e67e22;
}

.tag.tag-photo {
  background: #e8f5e9;
  color: #27ae60;
}

.tag.tag-hot {
  background: #ffebee;
  color: #e74c3c;
}

.tag.tag-night {
  background: #e8eaf6;
  color: #5c6bc0;
}

.dashboard-side {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.side-card {
  flex: 1;
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.side-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.side-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.side-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.side-tags {
  display: flex;
  gap: 8rpx;
}

.route-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.route-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.route-icon {
  font-size: 40rpx;
}

.route-title-group {
  flex: 1;
}

.route-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.route-duration {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.route-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.route-spots {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.route-spot-name {
  padding: 6rpx 16rpx;
  background: #f7efe5;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.route-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0ebe5;
}

.route-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #a34d2e;
}

.route-btn {
  font-size: 26rpx;
  color: #a34d2e;
}

.bottom-spacer {
  height: 40rpx;
}

.back-top {
  position: fixed;
  right: 30rpx;
  bottom: 160rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  z-index: 999;
}

.back-top.visible {
  opacity: 1;
  transform: scale(1);
}

.back-top-icon {
  font-size: 36rpx;
  color: #a34d2e;
}