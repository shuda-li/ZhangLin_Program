<view class="profile-page">
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="user-info">
        <view class="user-avatar">游</view>
        <view class="user-detail">
          <view class="user-name">游客用户</view>
          <view class="user-desc">探索樟林古港文化</view>
        </view>
      </view>
    </view>
  </view>

  <view class="profile-content">
    <view class="menu-section">
      <view class="menu-item" bindtap="openAiChat">
        <text class="menu-icon">💬</text>
        <text class="menu-text">与阿樟对话</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/activity/activity">
        <text class="menu-icon">🎯</text>
        <text class="menu-text">我的报名</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/ship-3d/ship-3d">
        <text class="menu-icon">🚢</text>
        <text class="menu-text">红头船3D</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-section">
      <view class="menu-item">
        <text class="menu-icon">📞</text>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <custom-tab-bar />
</view>