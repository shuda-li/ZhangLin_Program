.detail-page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: 120rpx;
}

.detail-header {
  position: relative;
  height: 450rpx;
}

.header-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
}

.header-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.back-btn {
  width: 70rpx;
  height: 70rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}

.header-info {
  color: #fff;
}

.spot-category {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

.spot-name {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.spot-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 6rpx;
  font-size: 22rpx;
}

.detail-content {
  padding: 30rpx;
}

.info-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f3ef;
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 28rpx;
}

.info-text {
  font-size: 28rpx;
  color: #333;
}

.desc-section,
.audio-section,
.features-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.audio-player {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.play-btn {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  font-size: 32rpx;
  color: #fff;
}

.play-btn.playing {
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
}

.audio-info {
  flex: 1;
}

.audio-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.audio-status {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.feature-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.feature-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.feature-value {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.action-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
}