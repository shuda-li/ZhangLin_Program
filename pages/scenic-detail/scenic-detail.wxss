@keyframes skeletonShimmer {
  0% { opacity: 0.4; }
  50% { opacity: 0.8; }
  100% { opacity: 0.4; }
}

.skeleton-block {
  background: #e8e0d6;
  border-radius: 12rpx;
  animation: skeletonShimmer 1.5s ease-in-out infinite;
}

.hero-card {
  background: linear-gradient(135deg, #ead8d1, #faf6f4);
  overflow: hidden;
}

.spot-image {
  height: 320rpx;
}

.spot-category {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(125, 69, 46, 0.1);
  color: #8d4e30;
  font-size: 22rpx;
}

.favorite-button {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f5e6dd;
  color: #8d4e30;
  font-size: 24rpx;
}

.spot-name-row {
  margin-top: 20rpx;
}

.spot-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #33251e;
}

.spot-audio-meta {
  margin-top: 10rpx;
  color: #92674b;
  font-size: 24rpx;
}

.spot-summary,
.spot-meta,
.guide-paragraph,
.bullet-item {
  margin-top: 14rpx;
  color: #6f6258;
  line-height: 1.75;
}

.gallery-scroll {
  margin-top: 20rpx;
  white-space: nowrap;
}

.gallery-row {
  display: inline-flex;
  gap: 16rpx;
}

.gallery-thumb {
  width: 180rpx;
  height: 128rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.guide-paragraph {
  margin-top: 18rpx;
}

.guide-paragraph-active {
  background: #fff2e8;
  border: 2rpx solid #d68057;
}

.audio-card {
  margin-top: 18rpx;
}

.audio-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3c2b23;
}

.audio-progress {
  color: #a15a35;
  font-size: 24rpx;
}

.audio-time {
  margin-top: 10rpx;
  color: #94684a;
  font-size: 24rpx;
}

.audio-desc {
  margin-top: 14rpx;
  line-height: 1.7;
  color: #6f6258;
}

.audio-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.audio-button {
  flex: 1;
  text-align: center;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: #f2e4d8;
  color: #8c4a2b;
}

.audio-button-primary {
  background: linear-gradient(135deg, #b85e36, #8f3b22);
  color: #fff;
}

.mode-tabs {
  display: flex;
  gap: 0;
  background: #f0e8dc;
  border-radius: 10rpx;
  padding: 4rpx;
  margin-top: 16rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #7d6b58;
  border-radius: 8rpx;
  transition: all 0.2s;
}
.mode-tab.active {
  background: #fff;
  color: #8b3a1a;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(139, 58, 26, 0.08);
}

.paragraph-index {
  margin-bottom: 10rpx;
  color: #9c6a4b;
  font-size: 22rpx;
}

/* ═══ 底部操作栏 ═══ */
.action-bar { display: flex; gap: 16rpx; }
.action-btn { display: inline-flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: #7d6b58; padding: 8rpx 20rpx; border-radius: 999rpx; background: #f7f0e8; transition: all 0.2s; }
.action-btn.liked { color: #e05050; background: #fde8e8; }
.action-btn.liked .ui-icon { color: #e05050; }

/* ═══ 评价卡片 ═══ */
.review-card { margin-top: 14rpx; }
.review-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; font-size: 22rpx; }
.review-nick { font-weight: 600; color: var(--ink); }
.review-stars { color: #c89050; font-size: 20rpx; }
.review-time { color: #9b8b7a; font-size: 20rpx; margin-left: auto; }
.review-content { font-size: 26rpx; color: #6b5744; line-height: 1.65; }

/* ═══ 评价面板 ═══ */
.review-overlay { position: fixed; inset: 0; z-index: 999; background: rgba(30,15,5,.5); display: flex; align-items: flex-end; opacity: 0; pointer-events: none; transition: opacity .3s; }
.review-overlay.show { opacity: 1; pointer-events: auto; }
.review-panel { width: 100%; background: #fffdf9; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 28rpx 60rpx; max-height: 75vh; overflow-y: auto; transform: translateY(100%); transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1); }
.review-overlay.show .review-panel { transform: translateY(0); }
.review-panel-header { display: flex; justify-content: space-between; align-items: center; font-size: 32rpx; font-weight: 700; color: #2f1f14; margin-bottom: 24rpx; }
.review-close { font-size: 36rpx; color: #9b8b7a; padding: 8rpx; }
.review-stars-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.star { font-size: 44rpx; color: #ddd; transition: color .15s; }
.star.active { color: #c89050; }
.review-textarea { width: 100%; height: 180rpx; background: #f7f3ec; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; line-height: 1.6; box-sizing: border-box; }
.upload-btn { display: inline-flex; padding: 16rpx 24rpx; background: #f7f3ec; border-radius: 8rpx; font-size: 24rpx; color: #6b5744; margin-top: 16rpx; }
.review-submit-btn { width: 100%; text-align: center; padding: 20rpx; background: linear-gradient(135deg, #8b3a1a, #b86a3a); color: #fff; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; margin-top: 28rpx; }
.review-submit-btn.disabled { opacity: .5; }

/* 统一线性图标适配 */
.mode-tab { display: inline-flex; align-items: center; gap: 8rpx; }
.action-btn .ui-icon { color: inherit; }
.review-close .ui-icon { color: inherit; }
