<view class="page">
  <view wx:if="{{loading}}" class="card hero-card">
    <view class="skeleton-block" style="height:320rpx;"></view>
    <view class="skeleton-block" style="height:36rpx;width:140rpx;margin-top:20rpx;"></view>
    <view class="skeleton-block" style="height:60rpx;width:480rpx;margin-top:20rpx;"></view>
    <view class="skeleton-block" style="height:24rpx;width:200rpx;margin-top:10rpx;"></view>
    <view class="skeleton-block" style="height:44rpx;width:560rpx;margin-top:14rpx;"></view>
    <view class="skeleton-block" style="height:20rpx;width:420rpx;margin-top:14rpx;"></view>
    <view style="display:flex;gap:16rpx;margin-top:20rpx;">
      <view class="skeleton-block" style="width:180rpx;height:128rpx;"></view>
      <view class="skeleton-block" style="width:180rpx;height:128rpx;"></view>
      <view class="skeleton-block" style="width:180rpx;height:128rpx;"></view>
      <view class="skeleton-block" style="width:180rpx;height:128rpx;"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section-spacing">
    <view class="section-title">看点提要</view>
    <view class="card">
      <view class="skeleton-block" style="height:22rpx;width:520rpx;margin-top:14rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:480rpx;margin-top:14rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:500rpx;margin-top:14rpx;"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section-spacing">
    <view class="section-title">智能讲解</view>
    <view class="card audio-card">
      <view class="skeleton-block" style="height:32rpx;width:180rpx;"></view>
      <view class="skeleton-block" style="height:24rpx;width:200rpx;margin-top:10rpx;"></view>
      <view class="skeleton-block" style="height:40rpx;width:560rpx;margin-top:14rpx;"></view>
      <view style="display:flex;gap:16rpx;margin-top:22rpx;">
        <view class="skeleton-block" style="flex:1;height:56rpx;"></view>
        <view class="skeleton-block" style="flex:1;height:56rpx;"></view>
      </view>
    </view>
    <view class="card guide-paragraph" style="margin-top:18rpx;">
      <view class="skeleton-block" style="height:20rpx;width:100rpx;margin-bottom:10rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:560rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:480rpx;margin-top:8rpx;"></view>
    </view>
    <view class="card guide-paragraph" style="margin-top:18rpx;">
      <view class="skeleton-block" style="height:20rpx;width:100rpx;margin-bottom:10rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:560rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:440rpx;margin-top:8rpx;"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section-spacing">
    <view class="section-title">游览提示</view>
    <view class="card">
      <view class="skeleton-block" style="height:22rpx;width:500rpx;margin-top:14rpx;"></view>
      <view class="skeleton-block" style="height:22rpx;width:460rpx;margin-top:14rpx;"></view>
    </view>
  </view>

  <view wx:if="{{!loading && scenicSpot}}">
    <view class="card hero-card">
      <image class="spot-image card-img-top" src="{{scenicSpot.image}}" mode="aspectFill" bindtap="previewGallery" data-current="{{scenicSpot.image}}" lazy-load="{{true}}" />
      <view class="row-between">
        <view class="spot-category">{{scenicSpot.category}}</view>
        <view class="action-bar">
          <view class="action-btn {{isLiked ? 'liked' : ''}} ui-press" bindtap="toggleLike"><view class="ui-icon ui-icon-heart ui-icon-sm"></view>点赞</view>
          <view class="action-btn ui-press" bindtap="openReview"><view class="ui-icon ui-icon-chat ui-icon-sm"></view>评价</view>
          <view class="action-btn ui-press" bindtap="toggleFavorite"><view class="ui-icon ui-icon-bookmark ui-icon-sm"></view>{{isFavorite ? '已收藏' : '收藏'}}</view>
        </view>
      </view>
      <view class="spot-name-row">
        <view class="spot-name">{{scenicSpot.name}}</view>
        <view class="spot-audio-meta">{{scenicSpot.audioMeta.narrator}} · {{scenicSpot.audioMeta.duration}}</view>
      </view>
      <view class="spot-summary">{{scenicSpot.summary}}</view>
      <view class="spot-meta">建议停留：{{scenicSpot.duration}} | 所在线索：{{scenicSpot.location}}</view>
      <scroll-view class="gallery-scroll" scroll-x="true" show-scrollbar="false">
        <view class="gallery-row">
          <block wx:for="{{gallery}}" wx:key="*this">
            <image class="gallery-thumb" src="{{item}}" mode="aspectFill" bindtap="previewGallery" data-current="{{item}}" />
          </block>
        </view>
      </scroll-view>
    </view>

    <view class="section-spacing">
      <view class="section-title">看点提要</view>
      <view class="card">
        <block wx:for="{{scenicSpot.highlights}}" wx:key="*this">
          <view class="bullet-item">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="section-spacing">
      <view class="section-title">智能讲解</view>
      <view class="card audio-card">
        <view class="row-between">
          <view class="audio-title">音频讲解</view>
          <view class="audio-progress">{{audioProgress}}%</view>
        </view>
        <view class="audio-time">{{currentTimeText}} / {{durationText}}</view>
        <view class="mode-tabs">
          <view class="mode-tab {{audioMode === 'script' ? 'active' : ''}}" bindtap="switchAudioMode" data-mode="script"><view class="ui-icon ui-icon-book ui-icon-sm"></view>文稿演示</view>
          <view class="mode-tab {{audioMode === 'audio' ? 'active' : ''}}" bindtap="switchAudioMode" data-mode="audio"><view class="ui-icon ui-icon-headphone ui-icon-sm"></view>音频收听</view>
        </view>
        <view class="audio-desc" wx:if="{{audioMode === 'audio' && !scenicSpot.audioUrl}}">音频资源制作中，敬请期待。可切换至「文稿演示」模式体验。</view>
        <view class="audio-actions">
          <view class="audio-button audio-button-primary" bindtap="toggleAudioGuide">
            {{isAudioPlaying ? '暂停讲解' : '播放讲解'}}
          </view>
          <view class="audio-button" bindtap="nextParagraph">下一段</view>
        </view>
      </view>
      <block wx:for="{{scenicSpot.audioGuide}}" wx:key="*this" wx:for-index="index">
        <view class="card guide-paragraph {{activeAudioIndex === index ? 'guide-paragraph-active' : ''}}">
          <view class="paragraph-index">第{{index + 1}}段</view>
          <view>{{item}}</view>
        </view>
      </block>
    </view>

    <view class="section-spacing">
      <view class="section-title">游览提示</view>
      <view class="card">
        <block wx:for="{{scenicSpot.tips}}" wx:key="*this">
          <view class="bullet-item">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="section-spacing" wx:if="{{reviews.length > 0}}">
      <view class="section-title">游客评价 ({{reviews.length}})</view>
      <block wx:for="{{reviews}}" wx:key="id">
        <view class="card review-card">
          <view class="review-header">
            <view class="review-nick">{{item.nickname}}</view>
            <view class="review-stars">{{item.starsText}}</view>
            <view class="review-time">{{item.timeText}}</view>
          </view>
          <view class="review-content">{{item.content}}</view>
          <view class="review-images" wx:if="{{item.images && item.images.length}}" style="display:flex;gap:8rpx;margin-top:10rpx;">
            <image wx:for="{{item.images}}" wx:for-item="img" src="{{img}}" mode="aspectFill" style="width:120rpx;height:120rpx;border-radius:8rpx;" />
          </view>
        </view>
      </block>
    </view>
  </view>
</view>

<!-- 评价面板：置于 .page 之外，避免 .page 的 transform 动画创建包含块导致 fixed 相对页面而非视口定位 -->
<view class="review-overlay {{showReviewPanel ? 'show' : ''}}" catchtap="closeReview">
  <view class="review-panel {{panelExpanded ? 'expanded' : ''}} {{panelDragging ? 'dragging' : ''}} {{panelSnapping ? 'snapping' : ''}}"
        catchtap="dummy" style="height:{{panelHeight}}px;">
    <!-- 顶部拖拽手柄：向上滑动可展开为全屏 -->
    <view class="review-handle-area"
          bindtouchstart="onHandleTouchStart"
          catchtouchmove="onHandleTouchMove"
          bindtouchend="onHandleTouchEnd"
          bindtouchcancel="onHandleTouchEnd">
      <view class="review-handle"></view>
    </view>
    <view class="review-panel-body">
      <view class="review-inner" style="padding-bottom:{{panelBottomPad}}px;">
        <view class="review-panel-header">
          <view>写评价</view>
          <view class="review-close ui-press" catchtap="closeReview"><view class="ui-icon ui-icon-close ui-icon-sm"></view></view>
        </view>
        <view class="review-stars-row">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{reviewRating >= item ? 'active' : ''}}" bindtap="setRating" data-rating="{{item}}">{{reviewRating >= item ? '★' : '☆'}}</text>
        </view>
        <textarea class="review-textarea" placeholder="分享你的游览感受（最多500字）" maxlength="{{500}}" value="{{reviewContent}}" bindinput="onReviewInput" adjust-position="{{true}}" cursor-spacing="{{24}}" />
        <view class="review-upload" wx:if="{{reviewImages.length < 3}}">
          <view class="upload-btn" bindtap="chooseReviewImage">+ 添加图片</view>
        </view>
        <view class="review-imgs-preview" wx:if="{{reviewImages.length > 0}}" style="display:flex;gap:8rpx;flex-wrap:wrap;">
          <view wx:for="{{reviewImages}}" wx:key="*this" style="position:relative;">
            <image src="{{item}}" mode="aspectFill" style="width:100rpx;height:100rpx;border-radius:8rpx;" />
            <view style="position:absolute;top:-6rpx;right:-6rpx;width:32rpx;height:32rpx;background:#8b3a1a;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20rpx;" bindtap="removeReviewImage" data-index="{{index}}"><view class="ui-icon ui-icon-close ui-icon-sm"></view></view>
          </view>
        </view>
        <view class="review-submit-btn {{submittingReview ? 'disabled' : ''}}" bindtap="submitReview">{{submittingReview ? '提交中...' : '提交评价'}}</view>
      </view>
    </view>
  </view>
</view>
