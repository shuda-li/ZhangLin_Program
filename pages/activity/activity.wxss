.activity-page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: 140rpx;
}

.activity-header {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/></svg>') repeat;
  background-size: 20px 20px;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 30rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.activity-content {
  padding: 20rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.card-tag.讲解 { background: #3498db; }
.card-tag.夜游 { background: #9b59b6; }
.card-tag.亲子 { background: #e67e22; }
.card-tag.文化 { background: #27ae60; }

.card-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.card-status.open {
  background: #e8f5e9;
  color: #27ae60;
}

.card-status.full {
  background: #ffebee;
  color: #e74c3c;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.card-location {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.enroll-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.enroll-bar {
  width: 120rpx;
  height: 8rpx;
  background: #e8e4de;
  border-radius: 4rpx;
  overflow: hidden;
}

.enroll-progress {
  height: 100%;
  background: linear-gradient(90deg, #d4a574 0%, #c19660 100%);
  border-radius: 4rpx;
}

.enroll-text {
  font-size: 22rpx;
  color: #888;
}

.enroll-btn {
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}