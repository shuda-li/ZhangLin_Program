.activity-page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: 140rpx;
}

.activity-header {
  position: relative;
  height: 200rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/></svg>') repeat;
  background-size: 20px 20px;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 30rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 登录横幅 */
.login-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #fff9f0 0%, #fff5e6 100%);
  border-bottom: 1rpx solid #f0e5d8;
}

.login-text {
  font-size: 26rpx;
  color: #8b3a1a;
}

.login-btn {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0e5d8;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #8b3a1a;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 2rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #e74c3c;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-content {
  padding: 20rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.activity-card.registered {
  border: 2rpx solid #e8f5e9;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.card-tag.tag-guide { background: #3498db; }
.card-tag.tag-night { background: #9b59b6; }
.card-tag.tag-family { background: #e67e22; }
.card-tag.tag-culture { background: #27ae60; }

.card-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.card-status.open {
  background: #e8f5e9;
  color: #27ae60;
}

.card-status.full {
  background: #ffebee;
  color: #e74c3c;
}

.card-status.registered {
  background: #e3f2fd;
  color: #1976d2;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #888;
}

.card-location {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.register-info {
  margin-bottom: 16rpx;
}

.register-time {
  font-size: 22rpx;
  color: #999;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.enroll-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.enroll-bar {
  width: 120rpx;
  height: 8rpx;
  background: #e8e4de;
  border-radius: 4rpx;
  overflow: hidden;
}

.enroll-progress {
  height: 100%;
  background: linear-gradient(90deg, #d4a574 0%, #c19660 100%);
  border-radius: 4rpx;
}

.enroll-text {
  font-size: 22rpx;
  color: #888;
}

.enroll-btn {
  padding: 12rpx 30rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
}

.enroll-btn.disabled {
  background: #ccc;
}

.cancel-btn {
  padding: 12rpx 30rpx;
  background: #ffebee;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #e74c3c;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}