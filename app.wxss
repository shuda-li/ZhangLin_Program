page {
  --color-primary: #8b3a1a;
  --color-primary-light: #a34d2e;
  --color-accent: #d4a574;
  --color-accent-light: #c19660;
  --color-bg: #f5f3ef;
  --color-bg-warm: #f7efe5;
  --color-bg-card: #ffffff;
  --color-bg-bar: #fffdf9;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-hint: #888888;
  --color-border: #e8e4de;
  --color-border-light: #f0ebe5;
  --color-success: #27ae60;
  --color-danger: #e74c3c;
  --color-family: #e67e22;
  --gradient-primary: linear-gradient(135deg, #8b3a1a 0%, #a34d2e 100%);
  --gradient-accent: linear-gradient(135deg, #d4a574 0%, #c19660 100%);
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-card-hover: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* Page header base */
.page-header {
  position: relative;
  height: 200rpx;
  background: var(--gradient-primary);
  overflow: hidden;
}

.page-header::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/></svg>') repeat;
  background-size: 20px 20px;
}

.page-header-content {
  position: relative;
  z-index: 1;
  padding: 60rpx 30rpx 30rpx;
}

.page-header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.page-header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* Fade-in animation */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeInUp 0.5s ease forwards;
}

/* Button press feedback */
.touch-active {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.touch-active:active {
  transform: scale(0.96);
  opacity: 0.85;
}