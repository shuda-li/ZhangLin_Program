# 后端服务环境变量示例
# 复制为 .env 并填写真实值，.env 已加入 .gitignore，切勿提交

# 服务端口
PORT=3000

# JWT 签名密钥（务必替换为高强度随机字符串，例如 openssl rand -hex 32）
JWT_SECRET=请替换为高强度随机字符串

# 管理员初始密码（首次启动用于生成哈希，见 routes/auth.js 说明）
ADMIN_PASSWORD=请替换为管理员密码

# AI 密钥（DeepSeek / Tavily）不再通过环境变量配置
# 请登录管理后台 -> 「AI 密钥设置」自行输入，密钥会加密存于 backend/data/.ai-keys.json
# 该数据文件已加入 .gitignore，请勿提交

# 密钥存储加密主密钥（可选，但生产强烈建议配置；未配置时回退使用 JWT_SECRET）
# 修改此值会导致已保存的密钥无法解密，需到管理后台重新输入
KEY_STORE_SECRET=请替换为用于加密AI密钥的随机字符串

# 允许的前端跨域来源，多个用英文逗号分隔；生产环境务必填写具体域名
CORS_ORIGIN=http://localhost:5173,https://your-domain.com
