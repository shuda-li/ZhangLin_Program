.cb { padding: 4rpx 0 8rpx; }

.cb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  border-top: 1rpx solid rgba(120, 80, 40, 0.1);
}
.cb-title { font-size: 26rpx; font-weight: 700; color: #3c2c20; }
.cb-count { font-size: 22rpx; color: #b26a1e; margin-left: 6rpx; }
.cb-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f7efe4;
  color: #8b3a1a;
  font-size: 22rpx;
}

.cb-form {
  margin: 0 28rpx 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #faf5ee;
  border: 1rpx solid rgba(178, 106, 30, 0.12);
}
.cb-nick {
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #3c2c20;
}
.cb-stars { display: flex; gap: 10rpx; margin: 16rpx 0 8rpx; }
.cb-star { font-size: 36rpx; line-height: 1; color: #d8cbb8; transition: color .15s; }
.cb-star.active { color: #c89050; }
.cb-input {
  width: 100%;
  height: 140rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #3c2c20;
}
.cb-submit {
  width: 100%;
  margin-top: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 999rpx;
  background: #e5d8c8;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  transition: background .2s, transform .18s;
}
.cb-submit.active { background: linear-gradient(135deg, #8b3a1a, #b86a3a); }
.cb-submit:active { transform: scale(.98); }

.cb-empty {
  padding: 36rpx 0 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a08d78;
}

.cb-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid rgba(120, 80, 40, 0.07);
}
.cb-avatar {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0dcc4, #d9b48a);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cb-avatar .ui-icon { color: #fff; }
.cb-main { flex: 1; min-width: 0; }
.cb-meta { display: flex; align-items: center; justify-content: space-between; }
.cb-nickname { font-size: 24rpx; font-weight: 600; color: #4a3526; }
.cb-time { font-size: 20rpx; color: #a08d78; margin-left: 16rpx; }
.cb-stars-static { margin-top: 4rpx; font-size: 20rpx; color: #c89050; letter-spacing: 2rpx; }
.cb-content { margin-top: 8rpx; font-size: 24rpx; line-height: 1.7; color: #6b5744; word-break: break-all; }
