.skeleton-container {
  padding: 0 30rpx;
  background: #f5f3ef;
  min-height: 100vh;
}

/* 骨架屏动画 */
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton-bg {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

/* 顶部栏 */
.skeleton-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.skeleton-location {
  width: 180rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-ai-btn {
  width: 120rpx;
  height: 56rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 30rpx;
}

/* Hero区域 */
.skeleton-hero {
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #d4c4b8 0%, #c4b4a8 100%);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}

.skeleton-title {
  width: 200rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.skeleton-subtitle {
  width: 300rpx;
  height: 32rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton-text {
  width: 100%;
  height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.skeleton-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 20rpx;
}

.skeleton-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.skeleton-stat-num {
  width: 60rpx;
  height: 44rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-stat-label {
  width: 80rpx;
  height: 28rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

/* 区块通用 */
.skeleton-section {
  margin-bottom: 40rpx;
}

.skeleton-section-title {
  width: 160rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.skeleton-section-more {
  width: 100rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

/* 快捷服务 */
.skeleton-service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.skeleton-service-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.skeleton-service-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 16rpx;
}

.skeleton-service-text {
  flex: 1;
  height: 60rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

/* 卡片 */
.skeleton-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
}

.skeleton-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.skeleton-card-title {
  width: 180rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-card-badge {
  width: 60rpx;
  height: 36rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-card-body {
  height: 200rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 16rpx;
}

/* 时间线 */
.skeleton-timeline {
  display: flex;
  gap: 30rpx;
  padding: 20rpx 0;
  overflow: hidden;
}

.skeleton-timeline-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}

.skeleton-timeline-year {
  width: 80rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.skeleton-timeline-dot {
  width: 16rpx;
  height: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.skeleton-timeline-content {
  width: 160rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

/* 景点速览 */
.skeleton-dashboard {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 20rpx;
}

.skeleton-main-card {
  grid-row: span 2;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.skeleton-card-image {
  height: 300rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
}

.skeleton-card-body {
  padding: 20rpx;
}

.skeleton-card-meta {
  width: 200rpx;
  height: 28rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

.skeleton-side-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-side-card {
  flex: 1;
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}

.skeleton-side-image {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}

.skeleton-side-body {
  flex: 1;
  height: 60rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  align-self: center;
}